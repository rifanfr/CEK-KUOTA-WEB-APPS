{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/generate-config.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/k/:id*",
      "destination": "/kuota?id=:id"
    },
    {
      "source": "/K/:id*",
      "destination": "/kuota?id=:id"
    },
    {
      "source": "/c/:id*",
      "destination": "/kuota?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/kasir",
      "destination": "/dispatch-console",
      "permanent": false
    }
  ]
}
